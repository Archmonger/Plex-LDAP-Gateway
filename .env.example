# LinuxServer base image runtime
PUID=1000
PGID=1000
TZ=UTC

# Required application settings
PLEX_OWNER_TOKEN=replace-with-your-owner-token
PLEX_MACHINE_IDENTIFIER=replace-with-your-plex-machine-id

# Optional application settings
PLEX_BASE_URL=https://plex.tv
PLEX_CLIENT_PRODUCT=Plex LDAP Gateway
PLEX_CLIENT_VERSION=0.1.0
PLEX_TIMEOUT_SECONDS=10
PLEX_LDAP_STRICT_MACHINE_MATCH=true
PLEX_LDAP_REFRESH_SECONDS=300
PLEX_LDAP_BASE_DN=dc=plex,dc=ldap
PLEX_LDAP_PORT=1389
PLEX_HTTP_PORT=7576
GATEWAY_LOG_LEVEL=error
GATEWAY_LOG_OUTPUT=console
GATEWAY_LOG_FILE_PATH=/config/logs/plex-ldap-gateway.log

# Host exposure for compose
PLEX_LDAP_BIND_ADDRESS=0.0.0.0
PLEX_HTTP_BIND_ADDRESS=127.0.0.1

# Crash-loop protection for the supervised process and container restarts
SERVICE_CRASH_MAX_ATTEMPTS=5
SERVICE_CRASH_WINDOW_SECONDS=300
SERVICE_CRASH_BACKOFF_SECONDS=10

# Live Plex integration tests
# Use an account that can authenticate through Plex and is authorized for the
# machine identifier above.
PLEX_TEST_BIND_LOGIN=
PLEX_TEST_BIND_PASSWORD=
# Optional. Defaults to PLEX_TEST_BIND_LOGIN if left empty.
PLEX_TEST_BIND_IDENTITY=
# Optional assertions.
PLEX_TEST_EXPECTED_USERNAME=
PLEX_TEST_EXPECTED_EMAIL=
